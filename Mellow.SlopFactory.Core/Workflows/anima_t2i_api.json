{
  "prompt": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "1girl, silver hair, red eyes, school uniform, cherry blossoms, masterpiece, best quality"
    },
    "_meta": {
      "title": "Prompt"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "anima-base-v1.0.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_06b_base.safetensors",
      "type": "stable_diffusion",
      "device": "default"
    },
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "_meta": {
      "title": "Load VAE"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": [
        "prompt",
        0
      ]
    },
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "worst quality, low quality, score_1, score_2, score_3, blurry, jpeg artifacts, sepia"
    },
    "_meta": {
      "title": "Negative Prompt"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty Latent Image"
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "seed": 0,
      "steps": 30,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "anima"
    },
    "_meta": {
      "title": "Save Image"
    }
  }
}